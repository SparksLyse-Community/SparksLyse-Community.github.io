---
interface Props {
  title?: string;
  description?: string;
  ogSlug?: string;
}

const {
  title = "SparksLyse, l'IA Open-Source",
  description = "Quand l'IA rencontre l'Open-Source",
} = Astro.props;

const siteUrl = Astro.url;

const pathname = Astro.url.pathname;

const ogName =
  pathname === "/"
    ? "home"
    : pathname
        .replace(/^\/|\/$/g, "")
        .replaceAll("/", "-")
        .replace(/[^a-zA-Z0-9-_]/g, "-");

const ogImage = `${siteUrl.origin}/og/${ogName}.png`;

const { lang: langParam } = Astro.params;
const lang = (langParam && langParam in languages ? langParam : defaultLang) as Lang;

const t = useTranslations(lang);

import "../styles/global.css";
import "../styles/fonts.css";

import noise from "../assets/images/noise.png";
import Navbar from "../components/Navbar";
import { Globe } from "lucide-react";
import { defaultLang, getLocalizedPath, languages, listLanguages, useTranslations, type Lang } from "@/i18n/ui";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={siteUrl.href} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}logo.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}logo.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl.href} />

    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <meta name="robots" content="max-image-preview:large" />
  </head>

  <body class="min-h-screen overflow-x-hidden bg-[#0a0a0a] text-white">
    <Navbar lang={lang} client:load />
    <slot />

    <footer
      class="relative
        z-10
        border-t
        border-white/10
        px-4
        py-8
  
        sm:px-6
        sm:py-10
  
        md:px-10
  
        lg:px-16"
    >
      <div
        class="mx-auto
          flex
          w-full
          max-w-300
          flex-col
          gap-6"
      >
        <div class="flex items-center justify-between gap-4">
          <div class="min-w-0">
          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("#hero", lang)}`}
            class="text-base
              font-medium
              text-white
              transition-opacity
              hover:opacity-80"
          >
            SparksLyse
          </a>

          <p class="mt-2 text-sm text-white/45">
            {t("footer.text")}
          </p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <Globe size={16} strokeWidth={1.75} className="text-white/55" aria-hidden="true" />
            <select
              id="footer-language"
              class="rounded border border-white/15 bg-[#111] px-3 py-2 text-sm text-white outline-none transition-colors focus:border-white/50"
              aria-label={lang === "fr" ? "Choisir la langue" : "Choose language"}
            >
              {listLanguages.map((language) => (
                <option value={language} selected={language === lang}>
                  {languages[language]}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="border-y border-white/10 py-4">
          <nav
            aria-label={lang === "fr" ? "Navigation du pied de page" : "Footer navigation"}
            class="flex
              flex-wrap
              gap-x-5
              gap-y-3
              text-sm
              text-white/55

              sm:gap-x-6"
          >
          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("#about", lang)}`}
            class="transition hover:text-white"
          >
            {t("index.about")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("#features", lang)}`}
            class="transition hover:text-white"
          >
            {t("footer.features")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("mentions-legales", lang)}`}
            class="transition hover:text-white"
          >
            {t("footer.legal")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("politique-confidentialite", lang)}`}
            class="transition hover:text-white"
          >
            {t("footer.confi")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("politique-cookies", lang)}`}
            class="transition hover:text-white"
          >
            {t("footer.cookies")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("cgu", lang)}`}
            class="transition hover:text-white"
          >
            {t("footer.cgu")}
          </a>

          <a
            href="https://github.com/SparksLyse-Community"
            target="_blank"
            rel="noreferrer"
            class="transition hover:text-white"
          >
            Github
          </a>

          <a
            href="https://discord.gg/wraa3dGTjr"
            target="_blank"
            rel="noreferrer"
            class="transition hover:text-white"
          >
            Discord
          </a>


          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("#faq", lang)}`}
            class="transition hover:text-white"
          >
            {t("index.faq")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("/partenaires", lang)}`}
            class="transition hover:text-white"
          >
            {t("index.partners")}
          </a>

          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("#soutien", lang)}`}
            class="transition hover:text-white"
          >
            {t("index.support")}
          </a>
          </nav>
        </div>
      </div>
    </footer>

    <div
      class="pointer-events-none
        fixed
        inset-0
        z-[-1]
        overflow-hidden
        opacity-[0.13]
        select-none"
      aria-hidden="true"
    >
      <div
        class="absolute
          inset-0
          bg-repeat
          bg-center"
        style={`
          background-image: url(${noise.src});
          background-size: 153.5px auto;
        `}
      >
      </div>
    </div>
  </body>
</html>

<script>
  const languageSelect = document.getElementById("footer-language");

  if (languageSelect instanceof HTMLSelectElement) {
    languageSelect.addEventListener("change", () => {
      const segments = window.location.pathname.split("/");
      const localeIndex = segments.findIndex((segment) => segment === "fr" || segment === "en");

      if (localeIndex === -1) return;

      segments[localeIndex] = languageSelect.value;
      window.location.assign(`${segments.join("/")}${window.location.hash}`);
    });
  }
</script>
