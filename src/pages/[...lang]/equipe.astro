---
import Layout from "../../layouts/Layout.astro";
import teamImage from "../../assets/images/about3.jpg";
import Profil from "@/components/Profil";
import {
  languages,
  defaultLang,
  useTranslations,
  getLocalizedPath,
  type Lang,
} from "../../i18n/ui";
import FadeInBlurWord from "@/components/animation/FadeInBlurWord";

export function getStaticPaths() {
  return [{ params: { lang: "fr" } }, { params: { lang: "en" } }];
}

const { lang: langParam } = Astro.params;
const lang = (
  langParam && langParam in languages ? langParam : defaultLang
) as Lang;

const t = useTranslations(lang);
---

<Layout title={t("equipe.title")} description={t("equipe.desc")}>
  <main class="flex flex-col text-white px-4">
    <section
      class="mx-auto grid min-h-[75svh] w-full max-w-7xl items-center gap-10 px-6 py-16 md:px-10 md:py-24 lg:grid-cols-[1fr_0.9fr] lg:gap-16 lg:px-16"
    >
      <div>
        <p class="mb-5 text-xs uppercase tracking-[0.18em] text-white/45">
          SparksLyse Community
        </p>
        <FadeInBlurWord
          as="h1"
          content={[
            {
              text: t("equipe.mainTitle"),
            },
          ]}
          className="max-w-xl font-sans text-4xl font-normal leading-[1.08] text-white sm:text-5xl"
          client:load
        />
        <FadeInBlurWord
          as="p"
          content={[
            {
              text: t("equipe.mainDesc"),
            },
          ]}
          className="mt-6 max-w-xl text-sm leading-7 text-white/60 sm:text-base"
          client:load
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://github.com/SparksLyse-Community"
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center border border-white/20 px-5 text-sm text-white transition hover:bg-white/10"
          >
            {t("equipe.seeGithub")}
          </a>
          <a
            href="https://discord.gg/wraa3dGTjr"
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center bg-[#e8ff9c] px-5 text-sm font-medium text-black transition hover:opacity-90"
          >
            {t("equipe.joinCommunity")}
          </a>
          <a
            href={`${import.meta.env.BASE_URL}${getLocalizedPath("contributors", lang)}`}
            class="inline-flex min-h-11 items-center border border-white/20 px-5 text-sm text-white transition hover:bg-white/10"
          >
            {t("equipe.allContrib")}
          </a>
        </div>
      </div>

      <figure
        class="relative min-h-72 overflow-hidden border border-white/10 sm:min-h-96 rounded-md"
      >
        <img
          src={teamImage.src}
          alt="Visuel du projet SparksLyse"
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
        />
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-black/70 px-5 py-4 text-xs text-white/70 backdrop-blur-sm"
        >
          {t("equipe.imageCaption")}
        </figcaption>
      </figure>
    </section>

    <section
      class="mx-auto w-full max-w-7xl px-6 pb-24 md:px-10 lg:px-16"
      aria-labelledby="core-team-heading"
    >
      <div class="border-t border-white/10 pt-7">
        <p class="mb-3 text-xs uppercase tracking-[0.18em] text-white/45">
          {t("equipe.equipe")}
        </p>
        <FadeInBlurWord
          as="h2"
          id="core-team-heading"
          content={[
            {
              text: t("equipe.behind"),
            },
          ]}
          className="text-2xl font-normal text-white sm:text-3xl"
          client:load
        />
        <FadeInBlurWord
          as="p"
          content={[
            {
              text: t("equipe.publicMember"),
            },
          ]}
          className="mt-3 max-w-2xl text-sm leading-7 text-white/55"
          client:load
        />

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <Profil
            username="Tonyx"
            imageLink="https://avatars.githubusercontent.com/u/257786487?v=4"
            link="https://github.com/Juste1dev"
            role="Grand patron"
            text="Contributions au training"
          />
          <Profil
            username="Marvideo"
            imageLink="https://avatars.githubusercontent.com/u/88560729?s=160&v=4"
            link="https://github.com/Marvideo2009"
            role="Référent training + Développement API et web"
            text="Contributions au training et au site SparksLyse ainsi aux services API du projet."
          />
          <Profil
            username="ElectroLynx"
            imageLink="https://avatars.githubusercontent.com/u/168107535?s=160&v=4"
            link="https://github.com/ElectroLynx"
            role="Communtity Manager"
            text="Contributions au site et au bon fonctionnement de la communauté."
          />
          <Profil
            username="Zerox"
            imageLink="https://avatars.githubusercontent.com/u/216586172?v=4"
            link="https://github.com/pauledithz"
            role="Référent visuel"
            text="Contributions au site."
          />
          <Profil
            username="Arthur Guerrier"
            imageLink="https://avatars.githubusercontent.com/u/181774290?v=4"
            link="https://github.com/ArthurGuerrier"
            role="Site web"
            text="Contributions au site."
          />
          <Profil
            username="22Parcival"
            imageLink="https://avatars.githubusercontent.com/u/241494785?v=4"
            link="https://github.com/22Parcival"
            role="Site web"
            text="Contributions au site."
          />
          <Profil
            username="Mianie Patooti"
            imageLink="https://cdn.discordapp.com/avatars/1079422776068280473/2799a54c23ecdc3f87372f37c2021d0c.webp?size=4096"
            link="https://discord.com/users/1079422776068280473"
            role="Artistes"
            text="Contributions a la création du design de SparksLyse."
          />
        </div>
      </div>
    </section>

    <section
      class="mx-auto w-full max-w-7xl px-6 pb-24 md:px-10 md:pb-32 lg:px-16"
    >
      <div class="border-t border-white/10">
        <FadeInBlurWord
          as="h2"
          content={[
            {
              text: t("equipe.contrib"),
            },
          ]}
          className="py-6 text-xl font-normal text-white sm:text-2xl"
          client:load
        />
        <div class="grid border-t border-white/10 md:grid-cols-3">
          <article class="border-b border-white/10 py-6 md:border-b-0 md:pr-8">
            <p class="text-xs uppercase tracking-[0.14em] text-[#e8ff9c]">
              01 / Code
            </p>
            <p class="mt-3 text-sm leading-7 text-white/60">
              {t("equipe.code")}
            </p>
            <a
              href="https://github.com/SparksLyse-Community"
              target="_blank"
              rel="noreferrer"
              class="mt-4 inline-block text-sm text-white underline decoration-white/25 underline-offset-4 transition hover:decoration-white"
            >
              {t("equipe.exploreCode")}
            </a>
          </article>
          <article
            class="border-b border-white/10 py-6 md:border-b-0 md:border-l md:px-8"
          >
            <p class="text-xs uppercase tracking-[0.14em] text-[#e8ff9c]">
              02 / Training
            </p>
            <p class="mt-3 text-sm leading-7 text-white/60">
              {t("equipe.training")}
            </p>
            <a
              href={`${import.meta.env.BASE_URL}${getLocalizedPath("train", lang)}`}
              class="mt-4 inline-block text-sm text-white underline decoration-white/25 underline-offset-4 transition hover:decoration-white"
            >
              {t("equipe.followTrain")}
            </a>
          </article>
          <article class="py-6 md:border-l border-white/10 md:px-8">
            <p class="text-xs uppercase tracking-[0.14em] text-[#e8ff9c]">
              03 / Community
            </p>
            <p class="mt-3 text-sm leading-7 text-white/60">
              {t("equipe.community")}
            </p>
            <a
              href="https://discord.gg/wraa3dGTjr"
              target="_blank"
              rel="noreferrer"
              class="mt-4 inline-block text-sm text-white underline decoration-white/25 underline-offset-4 transition hover:decoration-white"
            >
              {t("equipe.exchangeDiscord")}
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
