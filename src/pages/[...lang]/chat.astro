---
import Layout from "../../layouts/Layout.astro";
import FadeInBlurWord from "../../components/animation/FadeInBlurWord";
import "../../styles/chat.css";
import {
  languages,
  defaultLang,
  useTranslations,
  type Lang,
} from "../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "fr" } }, { params: { lang: "en" } }];
}

const { lang: langParam } = Astro.params;
const lang = (
  langParam && langParam in languages ? langParam : defaultLang
) as Lang;

const t = useTranslations(lang);
---

<Layout title={t("chat.title")} description={t("chat.desc")}>
  <main class="chat-workspace mx-auto flex w-full max-w-300 flex-col px-6 py-12 md:px-10 md:py-16 lg:px-16">
    <div class="chat-intro">
      <span
        class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
      >
        Chatbot
      </span>
      <FadeInBlurWord
        as="h1"
        content={[
          { text: t("chat.mainTitle") },
          {
            text: "SparksLyse",
            style: { color: "rgb(133, 133, 133)" },
          },
        ]}
        className="font-sans text-4xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-5xl justify-start"
        client:load
      />
    </div>

    <section class="chat-shell-integrated" aria-label={t("chat.title")}>
      <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-relevant="additions text"></div>

      <div class="chat-composer">
        <form id="composer-form">
          <div class="composer-card">
            <label class="sr-only" for="composer-input"
              >{t("chat.promptLabel")}</label
            >
            <textarea
              id="composer-input"
              rows="1"
              placeholder={t("chat.promptPlaceholder")}
              autocomplete="off"></textarea>

            <div class="composer-toolbar">
              <div class="composer-tools">
                <span class="tool-pill" title={t("future")}>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <path d="M3 9h18"></path>
                  </svg>

                  <span>{t("chat.library")}</span>
                </span>

                <button
                  class="tool-icon"
                  type="button"
                  title={t("future")}
                  disabled
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 12.5V7a2 2 0 0 0-2-2H8L4 9v10a2 2 0 0 0 2 2h6"
                    ></path>
                    <path d="M4 9h4V5"></path>
                  </svg>
                </button>

                <button
                  class="tool-icon"
                  type="button"
                  title={t("future")}
                  disabled
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <path d="M21 15l-5-5-4 4-2-2-4 4"></path>
                  </svg>
                </button>

                <button
                  class="tool-icon"
                  type="button"
                  title={t("future")}
                  disabled
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"
                    ></path>
                    <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                    <path d="M12 18v4"></path>
                  </svg>
                </button>
              </div>

              <button class="send-btn" id="send-btn" type="submit" aria-label={lang === "fr" ? "Envoyer le message" : "Send message"} disabled>
                <span class="send-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="19" x2="12" y2="5"></line>
                    <polyline points="6 11 12 5 18 11"></polyline>
                  </svg>
                </span>
                <span class="send-loading" aria-hidden="true">
                  <div class="loading-square"></div>
                </span>
              </button>
            </div>
          </div>
        </form>

        <div class="composer-hint">
          <span>{t("chat.composerHint")}</span>

          <button class="clear-btn" id="clear-btn" type="button">
            {t("chat.removeConv")}
          </button>
        </div>
        <p class="privacy-note">
          <span class="privacy-note-content">
            {t("chat.privacyNote")}
          </span>
          <a href={`${import.meta.env.BASE_URL}politique-confidentialite`}
            >{t("chat.privacyPolicy")}</a
          >.
        </p>
      </div>
    </section>
  </main>
  <div id="sparkslyse-config" data-lang={lang} data-welcome-message={t("chat.startMessage")} data-reset-conv={t("chat.resetConv")} data-api-error={t("apiError")}>
  </div>
</Layout>

<style is:global>
  /* ── Affichage des appels d'outils ───────────────────────── */
  .msg-tool {
    width: 100%;
  }

  .tool-card {
    width: min(100%, 36rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
  }

  .tool-card > summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .tool-card > summary::-webkit-details-marker {
    display: none;
  }

  .tool-status {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    box-sizing: border-box;
  }

  .tool-card[data-status="running"] .tool-status {
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.85);
    animation: tool-spin 0.8s linear infinite;
  }

  .tool-card[data-status="done"] .tool-status {
    background: #4ade80;
  }

  .tool-card[data-status="error"] .tool-status {
    background: #f87171;
  }

  .tool-title {
    flex: none;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
  }

  .tool-preview {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.45);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .tool-chevron {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: rgba(255, 255, 255, 0.45);
    transition: transform 0.15s ease;
  }

  .tool-card[open] .tool-chevron {
    transform: rotate(180deg);
  }

  .tool-body {
    display: grid;
    gap: 0.7rem;
    padding: 0.2rem 0.85rem 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tool-label {
    display: block;
    margin: 0.7rem 0 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .tool-body pre {
    margin: 0;
    max-height: 12rem;
    overflow: auto;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.3);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .tool-card[data-status="error"] .tool-result pre {
    color: #fca5a5;
  }

  .tool-card:not([data-status="running"]) .tool-result[hidden] {
    display: none;
  }

  /* Indicateur "le modèle réfléchit" tant qu'aucun texte n'est arrivé */
  .msg.is-pending .msg-bubble p:empty::after {
    content: "…";
    display: inline-block;
    animation: tool-pulse 1s ease-in-out infinite;
  }

  @keyframes tool-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes tool-pulse {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-status,
    .msg.is-pending .msg-bubble p:empty::after {
      animation: none;
    }
  }
</style>

<script>
  const configEl = document.getElementById("sparkslyse-config");
  if (configEl) {
    const config = configEl.dataset;

    // ── Constantes ───────────────────────────────────────────
    const API_URL = "https://marvideo.fr/lyseai-api/chat.php";
    /** Nombre max d'allers-retours outil → modèle pour une même question. */
    const MAX_TOOL_ROUNDS = 3;
    /** Le contexte du modèle est court : on tronque ce qu'on lui renvoie. */
    const MAX_RESULT_FOR_MODEL = 400;
    const MAX_RESULT_DISPLAY = 4000;

    const UI = (
      {
        fr: {
          using: "Outil",
          args: "Arguments",
          result: "Résultat",
          empty: "(réponse vide)",
          tooMany: "Trop d’appels d’outils consécutifs.",
          unknownTool: "Outil inconnu",
          badArgs: "Arguments invalides (JSON attendu)",
        },
        en: {
          using: "Tool",
          args: "Arguments",
          result: "Result",
          empty: "(empty reply)",
          tooMany: "Too many consecutive tool calls.",
          unknownTool: "Unknown tool",
          badArgs: "Invalid arguments (JSON expected)",
        },
      } as const
    )[config.lang === "en" ? "en" : "fr"];

    const uiLang = config.lang === "en" ? "en" : "fr";

    // ── Types ────────────────────────────────────────────────
    type Role = "user" | "assistant" | "system" | "tool";

    interface ToolCall {
      id: string;
      type: "function";
      function: { name: string; arguments: string };
    }

    interface Message {
      role: Role;
      content: string | null;
      tool_calls?: ToolCall[];
      tool_call_id?: string;
      name?: string;
    }

    interface Elements {
      messages: HTMLDivElement;
      form: HTMLFormElement;
      input: HTMLTextAreaElement;
      sendButton: HTMLButtonElement;
      clearButton: HTMLButtonElement;
    }

    interface State {
      history: Message[];
      sending: boolean;
    }

    interface ChatResult {
      content: string;
      toolCalls: ToolCall[];
      finishReason: string | null;
    }

    interface ToolDef {
      /** Schéma OpenAI envoyé au modèle (garde les descriptions COURTES : fenêtre de 512 tokens). */
      schema: {
        type: "function";
        function: {
          name: string;
          description: string;
          parameters: Record<string, unknown>;
        };
      };
      label: { fr: string; en: string };
      run: (args: Record<string, unknown>) => unknown | Promise<unknown>;
    }

    const elements: Partial<Elements> = {};

    const state: State = {
      history: [],
      sending: false,
    };

    // ── Outils exécutés côté navigateur ──────────────────────
    // ⚠ Les noms/paramètres doivent correspondre à ceux vus pendant le SFT (tool_data.py).
    function evaluateExpression(expression: string): number {
      const src = expression
        .replace(/×/g, "*")
        .replace(/÷/g, "/")
        .replace(/,/g, ".")
        .replace(/\s+/g, "");
      let pos = 0;

      const parseExpr = (): number => {
        let value = parseTerm();
        while (src[pos] === "+" || src[pos] === "-") {
          const op = src[pos++];
          const rhs = parseTerm();
          value = op === "+" ? value + rhs : value - rhs;
        }
        return value;
      };

      const parseTerm = (): number => {
        let value = parseUnary();
        while (src[pos] === "*" || src[pos] === "/" || src[pos] === "%") {
          const op = src[pos++];
          const rhs = parseUnary();
          value = op === "*" ? value * rhs : op === "/" ? value / rhs : value % rhs;
        }
        return value;
      };

      const parseUnary = (): number => {
        if (src[pos] === "-") {
          pos++;
          return -parseUnary();
        }
        if (src[pos] === "+") {
          pos++;
          return parseUnary();
        }
        return parsePow();
      };

      const parsePow = (): number => {
        const base = parseAtom();
        if (src[pos] === "^") {
          pos++;
          return base ** parseUnary();
        }
        return base;
      };

      const parseAtom = (): number => {
        if (src[pos] === "(") {
          pos++;
          const value = parseExpr();
          if (src[pos++] !== ")") throw new Error("Parenthèse manquante");
          return value;
        }
        const match = /^\d+(\.\d+)?/.exec(src.slice(pos));
        if (!match) throw new Error("Expression invalide");
        pos += match[0].length;
        return parseFloat(match[0]);
      };

      const result = parseExpr();
      if (pos !== src.length) throw new Error("Expression invalide");
      if (!Number.isFinite(result)) throw new Error("Résultat indéfini");
      return result;
    }

    const TOOLS: Record<string, ToolDef> = {
      calculator: {
        schema: {
          type: "function",
          function: {
            name: "calculator",
            description: "Calcule une expression arithmétique.",
            parameters: {
              type: "object",
              properties: {
                expression: { type: "string", description: "Ex : 12*(3+4)" },
              },
              required: ["expression"],
            },
          },
        },
        label: { fr: "Calculatrice", en: "Calculator" },
        run: (args) => {
          const expression = String(
            args.expression ?? args.expr ?? Object.values(args)[0] ?? "",
          );
          return { expression, result: evaluateExpression(expression) };
        },
      },

      get_current_time: {
        schema: {
          type: "function",
          function: {
            name: "get_current_time",
            description: "Donne la date et l’heure actuelles.",
            parameters: {
              type: "object",
              properties: {
                timezone: { type: "string", description: "Ex : Europe/Paris" },
              },
            },
          },
        },
        label: { fr: "Date et heure", en: "Date & time" },
        run: (args) => {
          const timeZone =
            typeof args.timezone === "string" && args.timezone
              ? args.timezone
              : Intl.DateTimeFormat().resolvedOptions().timeZone;
          const formatted = new Intl.DateTimeFormat("fr-FR", {
            dateStyle: "full",
            timeStyle: "short",
            timeZone,
          }).format(new Date());
          return { timezone: timeZone, datetime: formatted };
        },
      },

      get_weather: {
        schema: {
          type: "function",
          function: {
            name: "get_weather",
            description: "Météo actuelle d’une ville.",
            parameters: {
              type: "object",
              properties: {
                city: { type: "string", description: "Ex : Paris" },
              },
              required: ["city"],
            },
          },
        },
        label: { fr: "Météo", en: "Weather" },
        run: async (args) => {
          const city = String(args.city ?? args.location ?? "").trim();
          if (!city) throw new Error("Ville manquante");

          const geo = await fetch(
            `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=fr`,
          ).then((r) => r.json());
          const place = geo?.results?.[0];
          if (!place) throw new Error(`Ville introuvable : ${city}`);

          const weather = await fetch(
            `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&current=temperature_2m,wind_speed_10m`,
          ).then((r) => r.json());

          return {
            city: place.name,
            country: place.country,
            temperature_c: weather?.current?.temperature_2m,
            wind_kmh: weather?.current?.wind_speed_10m,
          };
        },
      },
    };

    const toolSchemas = Object.values(TOOLS).map((tool) => tool.schema);

    // ── Utilitaires ──────────────────────────────────────────
    function getElements(): Elements {
      const messages = document.getElementById("chat-messages");
      const form = document.getElementById("composer-form");
      const input = document.getElementById("composer-input");
      const sendButton = document.getElementById("send-btn");
      const clearButton = document.getElementById("clear-btn");

      if (
        !(messages instanceof HTMLDivElement) ||
        !(form instanceof HTMLFormElement) ||
        !(input instanceof HTMLTextAreaElement) ||
        !(sendButton instanceof HTMLButtonElement) ||
        !(clearButton instanceof HTMLButtonElement)
      ) {
        throw new Error("Unable to initialize the chat interface.");
      }

      return {
        messages,
        form,
        input,
        sendButton,
        clearButton,
      };
    }

    function escapeHtml(value: string): string {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function renderText(value: string): string {
      return escapeHtml(value)
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/\n/g, "<br>");
    }

    function scrollToBottom(): void {
      const messages = elements.messages;

      if (!messages) return;

      messages.scrollTop = messages.scrollHeight;
    }

    function stringify(value: unknown, pretty = false): string {
      if (typeof value === "string") return value;
      try {
        return JSON.stringify(value, null, pretty ? 2 : undefined) ?? String(value);
      } catch {
        return String(value);
      }
    }

    function truncate(value: string, max: number): string {
      return value.length > max ? `${value.slice(0, max)}…` : value;
    }

    // ── Appel API (SSE) avec gestion des tool_calls ──────────
    async function streamChatAPI(
      messages: Message[],
      onText: (text: string) => void,
      withTools: boolean,
    ): Promise<ChatResult> {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "text/event-stream",
        },
        body: JSON.stringify({
          messages,
          stream: true,
          ...(withTools ? { tools: toolSchemas } : {}),
        }),
      });

      if (!response.ok) {
        const errorText = await response.text();

        throw new Error(`API ${response.status}: ${errorText}`);
      }

      let content = "";
      let finishReason: string | null = null;
      // Les tool_calls arrivent par index (en un seul morceau avec serve_openai_server.py,
      // mais on gère aussi le format OpenAI incrémental via Open WebUI).
      const calls = new Map<number, ToolCall>();

      const handleData = (data: string): void => {
        let json: any;
        try {
          json = JSON.parse(data);
        } catch {
          return;
        }

        const choice = json?.choices?.[0];
        const delta = choice?.delta ?? choice?.message ?? {};

        const token = delta.content ?? json?.message?.content ?? json?.content ?? "";
        if (typeof token === "string" && token) {
          content += token;
          onText(token);
        }

        if (Array.isArray(delta.tool_calls)) {
          delta.tool_calls.forEach((tc: any, position: number) => {
            const index = typeof tc?.index === "number" ? tc.index : position;
            const current = calls.get(index) ?? {
              id: "",
              type: "function" as const,
              function: { name: "", arguments: "" },
            };

            if (tc?.id) current.id = tc.id;
            if (tc?.function?.name) current.function.name = tc.function.name;
            if (typeof tc?.function?.arguments === "string") {
              current.function.arguments += tc.function.arguments;
            } else if (tc?.function?.arguments && typeof tc.function.arguments === "object") {
              current.function.arguments = JSON.stringify(tc.function.arguments);
            }

            calls.set(index, current);
          });
        }

        if (choice?.finish_reason) finishReason = choice.finish_reason;
      };

      const handleEvent = (event: string): void => {
        for (const line of event.split("\n")) {
          const trimmed = line.trim();
          if (!trimmed.startsWith("data:")) continue;

          const data = trimmed.slice(5).trim();
          if (!data || data === "[DONE]") continue;

          handleData(data);
        }
      };

      const contentType = response.headers.get("content-type") ?? "";

      if (contentType.includes("application/json")) {
        // chat.php a répondu sans streaming : une seule réponse JSON complète.
        handleData(await response.text());
      } else {
        if (!response.body) {
          throw new Error("The browser does not support ReadableStream.");
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder("utf-8");
        let buffer = "";

        while (true) {
          const { done, value } = await reader.read();

          if (done) break;

          buffer += decoder.decode(value, { stream: true }).replace(/\r\n/g, "\n");

          const events = buffer.split("\n\n");
          buffer = events.pop() ?? "";

          for (const event of events) handleEvent(event);
        }

        buffer += decoder.decode();
        handleEvent(buffer.replace(/\r\n/g, "\n"));
      }

      const toolCalls = [...calls.entries()]
        .sort(([a], [b]) => a - b)
        .map(([, call]) => call)
        .filter((call) => call.function.name)
        .map((call) => ({
          ...call,
          id: call.id || `call_${crypto.randomUUID().replaceAll("-", "").slice(0, 12)}`,
          function: {
            ...call.function,
            arguments: call.function.arguments || "{}",
          },
        }));

      return { content, toolCalls, finishReason };
    }

    // ── Affichage des messages ───────────────────────────────
    function createMessageElement(message: Pick<Message, "role"> & { content: string }): HTMLDivElement {
      const { role, content } = message;

      const wrapper = document.createElement("div");

      wrapper.className = `msg ${role}`;

      const bubble = document.createElement("div");
      bubble.className = "msg-bubble";

      const paragraph = document.createElement("p");

      paragraph.className = "m-0";

      paragraph.innerHTML = renderText(content);

      bubble.appendChild(paragraph);
      wrapper.append(bubble);

      return wrapper;
    }

    function addMessage(message: Pick<Message, "role"> & { content: string }): void {
      const messages = elements.messages;

      if (!messages) return;

      messages.appendChild(createMessageElement(message));

      scrollToBottom();
    }

    // ── Carte d'appel d'outil ────────────────────────────────
    const CHEVRON_SVG =
      '<svg class="tool-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>';

    function createToolCard(name: string) {
      const label = TOOLS[name]?.label[uiLang] ?? name;

      const wrapper = document.createElement("div");
      wrapper.className = "msg assistant msg-tool";

      const card = document.createElement("details");
      card.className = "tool-card";
      card.dataset.status = "running";

      const summary = document.createElement("summary");

      const status = document.createElement("span");
      status.className = "tool-status";
      status.setAttribute("aria-hidden", "true");

      const title = document.createElement("span");
      title.className = "tool-title";
      title.textContent = `${UI.using} · ${label}`;

      const preview = document.createElement("span");
      preview.className = "tool-preview";

      summary.append(status, title, preview);
      summary.insertAdjacentHTML("beforeend", CHEVRON_SVG);

      const body = document.createElement("div");
      body.className = "tool-body";

      const makeSection = (labelText: string, className: string) => {
        const section = document.createElement("div");
        section.className = className;
        const labelEl = document.createElement("span");
        labelEl.className = "tool-label";
        labelEl.textContent = labelText;
        const pre = document.createElement("pre");
        section.append(labelEl, pre);
        return { section, pre };
      };

      const argsSection = makeSection(UI.args, "tool-args");
      const resultSection = makeSection(UI.result, "tool-result");
      resultSection.section.hidden = true;

      body.append(argsSection.section, resultSection.section);
      card.append(summary, body);
      wrapper.append(card);

      return {
        el: wrapper,
        setArgs(args: unknown): void {
          argsSection.pre.textContent = stringify(args, true);
          const values =
            args && typeof args === "object" ? Object.values(args as object) : [args];
          preview.textContent = truncate(values.map((v) => stringify(v)).join(", "), 48);
        },
        finish(outcome: "done" | "error", result: unknown): void {
          card.dataset.status = outcome;
          resultSection.pre.textContent = truncate(stringify(result, true), MAX_RESULT_DISPLAY);
          resultSection.section.hidden = false;
        },
      };
    }

    function parseArguments(raw: string): Record<string, unknown> {
      const text = raw.trim();
      if (!text) return {};

      let parsed: unknown;
      try {
        parsed = JSON.parse(text);
      } catch {
        throw new Error(UI.badArgs);
      }

      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
        throw new Error(UI.badArgs);
      }

      return parsed as Record<string, unknown>;
    }

    /** Exécute un appel d'outil, met à jour la carte et renvoie le contenu du message `tool`. */
    async function executeToolCall(call: ToolCall): Promise<string> {
      const name = call.function.name;
      const card = createToolCard(name);

      elements.messages?.appendChild(card.el);
      card.setArgs(call.function.arguments);
      scrollToBottom();

      try {
        const args = parseArguments(call.function.arguments);
        card.setArgs(args);

        const tool = TOOLS[name];
        if (!tool) throw new Error(`${UI.unknownTool} : ${name}`);

        const result = await tool.run(args);
        card.finish("done", result);

        return truncate(stringify(result), MAX_RESULT_FOR_MODEL);
      } catch (error: unknown) {
        const message = error instanceof Error ? error.message : String(error);
        card.finish("error", { error: message });

        return JSON.stringify({ error: message });
      } finally {
        scrollToBottom();
      }
    }

    // ── Boucle de conversation : modèle → outils → modèle ────
    async function runConversation(ctx: { bubble: HTMLDivElement | null }): Promise<void> {
      for (let round = 0; round <= MAX_TOOL_ROUNDS; round++) {
        const bubble = createMessageElement({ role: "assistant", content: "" });
        bubble.classList.add("is-pending");
        ctx.bubble = bubble;

        elements.messages?.appendChild(bubble);
        scrollToBottom();

        const paragraph = bubble.querySelector(".msg-bubble p");

        if (!paragraph) {
          throw new Error("Unable to create the chatbot response.");
        }

        let streamed = "";

        const result = await streamChatAPI(
          state.history,
          (chunk) => {
            streamed += chunk;
            bubble.classList.remove("is-pending");
            paragraph.innerHTML = renderText(streamed);
            scrollToBottom();
          },
          round < MAX_TOOL_ROUNDS,
        );

        bubble.classList.remove("is-pending");

        // Réponse finale en texte
        if (result.toolCalls.length === 0) {
          if (result.content.trim()) {
            paragraph.innerHTML = renderText(result.content);
            state.history.push({ role: "assistant", content: result.content });
          } else {
            paragraph.textContent = UI.empty;
          }
          return;
        }

        // Le modèle demande des outils : on garde le texte éventuel, sinon on retire la bulle vide
        if (!result.content.trim()) bubble.remove();
        ctx.bubble = null;

        state.history.push({
          role: "assistant",
          content: result.content || null,
          tool_calls: result.toolCalls,
        });

        for (const call of result.toolCalls) {
          const output = await executeToolCall(call);

          state.history.push({
            role: "tool",
            tool_call_id: call.id,
            name: call.function.name,
            content: output,
          });
        }
      }

      addMessage({ role: "system", content: UI.tooMany });
    }

    function autoGrow(): void {
      const input = elements.input;

      if (!input) return;

      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
    }

    function setSending(sending: boolean): void {
      state.sending = sending;

      const sendButton = elements.sendButton;
      if (!sendButton) return;

      sendButton.setAttribute("aria-busy", String(sending));

      updateSendButtonState();
    }

    async function handleSubmit(event: SubmitEvent): Promise<void> {
      event.preventDefault();

      if (state.sending) {
        return;
      }

      const input = elements.input;

      if (!input) {
        return;
      }

      const content = input.value.trim();

      if (!content) {
        return;
      }

      setSending(true);

      input.value = "";
      autoGrow();

      const userMessage: Message = {
        role: "user",
        content,
      };

      state.history.push(userMessage);
      addMessage({ role: "user", content });

      scrollToBottom();

      const ctx: { bubble: HTMLDivElement | null } = { bubble: null };

      try {
        await runConversation(ctx);
      } catch (error: unknown) {
        const message =
          error instanceof Error
            ? error.message
            : "An unknown error has occurred.";

        const text = `${config.apiError || "API Error"}: ${message}`;
        const paragraph = ctx.bubble?.querySelector(".msg-bubble p");

        if (ctx.bubble && paragraph) {
          ctx.bubble.classList.remove("is-pending");
          paragraph.textContent = text;
        } else {
          addMessage({ role: "assistant", content: text });
        }
      } finally {
        setSending(false);
        input.focus();
      }
    }

    function addWelcomeMessage(): void {
      addMessage({
        role: "assistant",
        content: config.welcomeMessage || "Hello 👋! I'm SparksLyse!",
      });
    }

    function clearConversation(): void {
      const messages = elements.messages;

      if (!messages) return;

      state.history.length = 0;

      messages.replaceChildren();

      addMessage({
        role: "system",
        content: config.resetConv || "Conversation reset.",
      });

      addWelcomeMessage();
    }

    function handleInputKeydown(event: KeyboardEvent): void {
      if (event.key !== "Enter" || event.shiftKey || event.isComposing) {
        return;
      }

      event.preventDefault();

      elements.form?.requestSubmit();
    }

    function bindEvents(): void {
      const { form, input, clearButton } = elements as Elements;

      form.addEventListener("submit", handleSubmit);

      input.addEventListener("input", () => {
        autoGrow();
        updateSendButtonState();
      });

      input.addEventListener("keydown", handleInputKeydown);

      clearButton.addEventListener("click", clearConversation);
    }

    async function init(): Promise<void> {
      Object.assign(elements, getElements());

      bindEvents();

      addWelcomeMessage();

      elements.input?.focus();
      autoGrow();

      updateSendButtonState();
    }

    function updateSendButtonState(): void {
      const input = elements.input;
      const sendButton = elements.sendButton;

      if (!input || !sendButton) return;

      const isEmpty = input.value.trim().length === 0;

      if (isEmpty || state.sending) {
        sendButton.disabled = true;
      } else {
        sendButton.disabled = false;
      }
    }

    void init();
  }
</script>